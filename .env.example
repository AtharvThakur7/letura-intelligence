DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=letura_intelligence
DB_USER=your_mysql_user
DB_PASSWORD=replace_locally

# Dedicated SELECT-only account for the dashboard and AI analyst.
# Created automatically by `python scripts/run_pipeline.py` (needs admin DB_USER).
AI_DB_USER=letura_ai_readonly
AI_DB_PASSWORD=replace_locally

OPENAI_API_KEY=replace_with_new_rotated_key
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=false
AI_MAX_OUTPUT_TOKENS=800
AI_QUERY_TIMEOUT_SECONDS=15
APP_ENV=local
